# ====================================================================
# Clipping Alfa — Configuración de Entorno y Autenticación
# ====================================================================

# Token Secreto para autenticar llamadas a la API y WebSocket desde Vercel / Clientes remotos.
# Genera un token seguro (ej. con: python -c "import secrets; print(secrets.token_hex(24))")
CLIPPING_API_TOKEN=tu_token_secreto_aqui_123456789

# Orígenes CORS permitidos (separados por coma)
ALLOWED_ORIGINS=https://clipping-alfa.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Host y puerto para FastAPI (opcional, por defecto 0.0.0.0:8000)
API_HOST=0.0.0.0
API_PORT=8000
